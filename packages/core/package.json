{
  "name": "@intentctrl/core",
  "version": "0.0.1",
  "type": "module",
  "description": "Framework-agnostic engine for IntentCtrl",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@intentctrl/types": "workspace:*",
    "turndown": "^7.2.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentctrl/eslint-config": "workspace:*",
    "@intentctrl/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/turndown": "^5.0.5",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
