{
  "name": "@intentctrl/react",
  "version": "1.0.0",
  "type": "module",
  "description": "React integration for IntentCtrl",
  "license": "MIT",
  "keywords": [
    "ai",
    "intent",
    "react",
    "hooks",
    "llm",
    "agents",
    "ui"
  ],
  "contributors": [
    {
      "name": "Swarup Kanade",
      "url": "https://github.com/swarupkanade"
    },
    {
      "name": "Omkar Kanade",
      "url": "https://github.com/omkarkanade"
    }
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/intentctrl/intentctrl",
    "directory": "packages/react"
  },
  "homepage": "https://intentctrl.com",
  "bugs": {
    "url": "https://github.com/intentctrl/intentctrl/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.2",
    "@intentctrl/core": "workspace:*",
    "@intentctrl/types": "workspace:*",
    "ai": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentctrl/eslint-config": "workspace:*",
    "@intentctrl/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
