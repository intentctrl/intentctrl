{
  "name": "@intentctrl/react",
  "version": "0.0.1",
  "type": "module",
  "description": "React integration for IntentCtrl",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.2",
    "@intentctrl/core": "workspace:*",
    "@intentctrl/types": "workspace:*",
    "ai": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentctrl/eslint-config": "workspace:*",
    "@intentctrl/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
