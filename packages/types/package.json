{
  "name": "@intentctrl/types",
  "version": "0.0.1",
  "type": "module",
  "description": "Shared TypeScript types for IntentCtrl",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "ai": "catalog:"
  },
  "devDependencies": {
    "@intentctrl/eslint-config": "workspace:*",
    "@intentctrl/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
