{
  "name": "@intentctrl/types",
  "version": "1.0.1",
  "type": "module",
  "description": "Shared TypeScript types for IntentCtrl",
  "license": "MIT",
  "keywords": [
    "ai",
    "intent",
    "typescript",
    "types",
    "llm",
    "agents"
  ],
  "contributors": [
    {
      "name": "Swarup Kanade",
      "url": "https://github.com/swarupkanade"
    },
    {
      "name": "Omkar Kanade",
      "url": "https://github.com/omkarkanade"
    }
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/intentctrl/intentctrl",
    "directory": "packages/types"
  },
  "homepage": "https://intentctrl.com",
  "bugs": {
    "url": "https://github.com/intentctrl/intentctrl/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "ai": "catalog:"
  },
  "devDependencies": {
    "@intentctrl/eslint-config": "workspace:*",
    "@intentctrl/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
